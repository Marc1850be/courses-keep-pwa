# Copiez ce fichier en ".env" et renseignez vos valeurs

# --- Google Keep (Backend Python gkeepapi) ---
# Conseil sécurité : utilisez idéalement un compte Gmail dédié "famille" ajouté
# comme collaborateur à votre liste Google Keep !
GOOGLE_EMAIL=
GOOGLE_MASTER_TOKEN=

# ID de votre liste Google Keep (la partie après #LIST/ dans l'URL)
KEEP_LIST_ID=VOTRE_ID_LISTE_GOOGLE_KEEP

# Titre de secours si l'ID change un jour (optionnel)
KEEP_LIST_TITLE=Courses

# Code PIN familial pour protéger la PWA (laisser vide pour désactiver)
FAMILY_PIN=1234

# Passer à "true" pour tester en mode local JSON sans Google Keep
KEEP_DEMO_MODE=false

# Origines CORS autorisées ("*" ou liste séparée par des virgules)
CORS_ORIGINS=*
